# ENSCS FOOTBALL TOURNAMENT PLATFORM
# Environment Configuration

# Administrator login. Set these as private settings on the server; never commit real values.
# ADMIN_USERNAME is optional (keeps the current username when omitted).
# ADMIN_PASSWORD=choose-a-long-private-password
# ADMIN_USERNAME=your-admin-name

# Optional: secret used to sign admin sessions (any long random text).
# When omitted, one is derived automatically from the private settings above.
# JWT_SECRET=

# Server Port
PORT=3000

# Cloud backup of tournament data (required on hosts without a persistent disk,
# e.g. Render free plan). A GitHub fine-grained token with "Contents: Read and
# write" on the repository below. Never commit the real token.
# GITHUB_BACKUP_TOKEN=github_pat_xxx
# GITHUB_BACKUP_REPO=MD1007/enscs-football
# GITHUB_BACKUP_BRANCH=data-backup

# Optional: folder holding tournament.db (use a mounted persistent disk path)
# DATA_DIR=/var/data

# Optional: Supabase credentials (if deploying with remote Supabase database)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

